{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MetaClean",
  "version": "0.1.0",
  "identifier": "com.moresl.metaclean",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "MetaClean", "width": 1100, "height": 760, "minWidth": 760, "minHeight": 620, "resizable": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
