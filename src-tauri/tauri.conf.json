{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MetaClean",
  "version": "0.7.0",
  "identifier": "com.moresl.metaclean",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "MetaClean", "width": 1180, "height": 720, "minWidth": 1180, "minHeight": 720, "maxWidth": 1180, "maxHeight": 720, "resizable": false, "maximizable": false, "decorations": false, "shadow": true }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installerHooks": "./windows/hooks.nsh" },
      "wix": {
        "fragmentPaths": ["./windows/fragments/context-menu-cleanup.wxs"],
        "componentRefs": ["MetaCleanContextMenuCleanup"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFENDBGNEVGNDFFQUExQkEKUldTNm9lcEI3L1JBSFF6bHZMK0NXZVg5Ry9DcDBlUm9pbjY2dVQvMUFiaklDYWhQUDdmSzA3bzcK",
      "endpoints": [
        "https://github.com/Moresyl/metaclean/releases/latest/download/latest.json",
        "https://moresyl.github.io/metaclean/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
