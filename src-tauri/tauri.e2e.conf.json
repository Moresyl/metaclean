{
  "build": {
    "beforeBuildCommand": "pnpm build:e2e"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "e2e-wdio",
          "description": "Test-only WebdriverIO commands for the E2E build.",
          "windows": ["main"],
          "permissions": ["wdio:default"]
        }
      ]
    }
  }
}
